# Hermes Agent config — lives at ~/.hermes/config.yaml inside the container
# (HERMES_HOME=/home/hermes/.hermes, on the shared `hermes-home` volume).
#
# Every model call is routed through the LiteLLM proxy rather than direct to a vendor, so the
# client's budget, request logs and Langfuse traces all apply to Hermes exactly as they do to the
# fleet. The api_key comes from OPENAI_API_KEY in the environment — the client's LiteLLM virtual
# key — so a conversation can only ever spend that client's budget.
#
# Alternatives to key_env, per the Hermes docs: an inline `api_key` (do not — it puts the secret in
# config) or `key_cmd` to mint a token dynamically (useful later if keys become short-lived).

# ── Default model ─────────────────────────────────────────────────────
# DECISION (user, 2026-08-19): webintelligenz's Hermes runs on deepseek flash.
# SUPERSEDED (Harsh, 2026-09-04): the live default is `standard` (DeepSeek V4 Pro) for all six profiles.
#
# These two top-level keys are what Hermes actually reads for its default (config.get("model") /
# config.get("provider")). model_aliases below are NOT a default — they are named shortcuts. With
# these keys absent, Hermes sent no Authorization header and every turn failed
# `HTTP 401: Missing Authentication header`, working only when `--provider litellm -m flash` was
# passed explicitly. That made the CLI look broken and would have broken the webui path too.
#
# `hermes model` is the intended way to set this but is interactive-only, so it is set in config.
#
# Verified live via LiteLLM spend logs: model deepseek-v4-flash-0731, team client-webintelligenz,
# real non-zero spend — so the model, the per-client attribution and the budget path all hold.
model: standard
provider: litellm

providers:
  litellm:
    api: http://litellm-v10up2yg1cwxo0k1ks9j2qro:4000/v1
    # key_env references an env var by NAME rather than inlining the secret. A custom-named
    # provider does NOT pick up OPENAI_API_KEY implicitly — that only feeds the built-in openai
    # provider. Without this Hermes sends the literal string "no-key-required" and LiteLLM 401s.
    key_env: OPENAI_API_KEY
    # discover_models: false — do NOT let Hermes enumerate /models. LiteLLM exposes every alias the
    # key can reach (fleet tiers, embeddings, the tier-blocked partner models). Hermes should only
    # ever offer the conversational ones, and an explicit list is also immune to the listing being
    # slow on a loaded host.
    discover_models: false
    models:
      - flash
      - standard

model_aliases:
  # Default for client conversation. deepseek-v4-flash at $0.08/$0.25 per M is ~16x cheaper both
  # ways than the pro tier — the right trade for a front-door that is high-turn and low-depth.
  hermes-default:
    model: flash
    provider: litellm
  # Escalation for a genuinely hard question, used sparingly. The fleet does the real work; Hermes
  # should hand off rather than reason deeply on its own.
  hermes-deep:
    model: standard
    provider: litellm

# ── Kanban dispatcher (2026-09-15) ────────────────────────────────────
kanban:
  dispatch_in_gateway: true
  # `kanban decompose` / auto-decompose is broken under gateway.multiplex_profiles
  # (get_secret('OPENAI_API_KEY') has no profile secret scope) and retried the two triage
  # parents every 60 s for a week. Webster composes chains with explicit kanban_create calls.
  auto_decompose: false
  # Bound a wedged worker (boot-captured; applies at the next gateway start).
  dispatch_stale_timeout_seconds: 1800
  dispatch_interval_seconds: 60
  max_in_progress: 4
  max_in_progress_per_profile: 1

# ── Cron (2026-09-15) ─────────────────────────────────────────────────
cron:
  allow_agent_scheduling: true
  # The pre-dispatch delivery check false-blocked review-notify ("email has no gateway
  # credentials", 09-14 19:36 / 19:52). All LLM jobs deliver to local (never checked), so
  # preflight only ever gated the no-agent email alert jobs — where a false block is worst-case.
  preflight: false

