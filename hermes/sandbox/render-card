#!/bin/sh
# render-card — render a local HTML file to a fixed-size PNG using headless Chromium.
# The fleet's HTML→PNG path for social/blog template cards (the producer's real render step;
# AI-gen via Higgsfield is separate). Runs headless with --no-sandbox (required: the container
# sets no-new-privileges, so Chromium's own SUID sandbox can't start).
#
# Usage:  render-card <input.html> <output.png> [width] [height] [scale]
#   defaults: 1200x630 (FB/blog link card), scale 2 for crisp text (downscale in-viewer is fine).
#   IG 4:5  -> render-card card.html out.png 1080 1350
#   GBP 4:3 -> render-card card.html out.png 1200 900
#
# The HTML's <body> should be exactly WxH (no margin) so the capture is pixel-exact. Brand fonts resolve
# three ways: baked into the image (Jost, Open Sans — see the Dockerfile), a local @font-face file from
# the client's brand kit, or a remote stylesheet (the sandbox does have internet egress). Before
# rendering, every font-family named in a LOCAL html file is checked against those routes and the render
# is REFUSED if a family can reach none of them — a card that silently falls back to Liberation Sans
# looks almost right and ships as a brand defect. Override with --allow-font-fallback if that is
# genuinely what you want.
set -eu

ALLOW_FALLBACK=0
if [ "${1:-}" = "--allow-font-fallback" ]; then ALLOW_FALLBACK=1; shift; fi

IN=${1:?usage: render-card [--allow-font-fallback] <input.html> <output.png> [width] [height] [scale]}
OUT=${2:?output.png required}
W=${3:-1200}
H=${4:-630}
SCALE=${5:-2}

case "$IN" in
  http://*|https://*|file://*) URL="$IN" ;;
  *) URL="file://$(readlink -f "$IN")" ;;
esac

# --- font preflight (local files only; a remote URL's CSS isn't ours to vet) -------------------------
case "$IN" in
  http://*|https://*) ;;
  *)
    FONT_RC=0
    python3 - "$(readlink -f "${IN#file://}")" <<'PY' || FONT_RC=$?
import re, subprocess, sys

html = open(sys.argv[1], encoding="utf-8", errors="replace").read()

# Families the document actually asks for, in declaration order, first (most-preferred) name only.
declared = []
for decl in re.findall(r"font-family\s*:\s*([^;\"'}]*(?:'[^']*'|\"[^\"]*\")?[^;\"'}]*)", html, re.I):
    first = decl.split(",")[0].strip().strip("'\"")
    if first and first.lower() not in ("inherit", "initial", "unset") and first not in declared:
        declared.append(first)

# Families the document supplies itself via @font-face, and whether it pulls any remote stylesheet.
selfhosted = {m.strip("'\" ").lower()
              for m in re.findall(r"@font-face[^}]*?font-family\s*:\s*([^;]+);", html, re.I | re.S)}
has_remote_css = bool(re.search(r"<link[^>]+href=[\"']https?://[^\"']+", html, re.I))

def resolves_locally(fam):
    """fc-match always answers; it's only a real hit if the family it names is the one we asked for."""
    try:
        out = subprocess.run(["fc-match", "-f", "%{family}", fam],
                             capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return False
    return fam.lower() in [f.strip().lower() for f in out.split(",")]

missing = [f for f in declared
           if f.lower() not in selfhosted
           and not resolves_locally(f)
           and f.lower() not in ("arial", "sans-serif", "serif", "monospace", "helvetica")]

for f in declared:
    where = ("@font-face" if f.lower() in selfhosted
             else "system" if resolves_locally(f)
             else "REMOTE-ONLY" if has_remote_css else "MISSING")
    print("render-card: font %-22s %s" % (f, where), file=sys.stderr)

if missing and not has_remote_css:
    print("render-card: REFUSING — no source for font(s): %s" % ", ".join(missing), file=sys.stderr)
    print("  Install them in the image, or add an @font-face with a local file from the brand kit.",
          file=sys.stderr)
    print("  Re-run with --allow-font-fallback only if a substituted font is genuinely acceptable.",
          file=sys.stderr)
    sys.exit(3)
PY
    if [ "$FONT_RC" = "3" ] && [ "$ALLOW_FALLBACK" = "0" ]; then exit 3; fi
    ;;
esac

# --headless=old captures exactly the --window-size viewport (new headless captures full page).
chromium \
  --headless=old \
  --no-sandbox \
  --disable-gpu \
  --disable-dev-shm-usage \
  --hide-scrollbars \
  --force-device-scale-factor="$SCALE" \
  --default-background-color=00000000 \
  --window-size="${W},${H}" \
  --virtual-time-budget=8000 \
  --screenshot="$OUT" \
  "$URL" >/dev/null 2>&1

if [ ! -s "$OUT" ]; then
  echo "render-card: FAILED — no output written for $URL" >&2
  exit 1
fi
# report real dimensions so the caller can verify (never trust the request)
python3 - "$OUT" <<'PY'
import struct, sys
p = sys.argv[1]
with open(p, "rb") as f:
    head = f.read(24)
if head[:8] == b"\x89PNG\r\n\x1a\n" and head[12:16] == b"IHDR":
    w, h = struct.unpack(">II", head[16:24])
    import os
    print(f"render-card: OK {p} {w}x{h} ({os.path.getsize(p)} bytes)")
else:
    print(f"render-card: WROTE {p} but it is not a valid PNG", file=sys.stderr); sys.exit(1)
PY
