# SearXNG settings for the fleet — internal-only search provider for Firecrawl web_search.
# Firecrawl queries GET /search?...&format=json, so json MUST be in search.formats or it 403s.
use_default_settings: true
general:
  instance_name: "fleet-search"
  debug: false
server:
  secret_key: "REDACTED-generate-with-openssl-rand-hex-32"
  bind_address: "0.0.0.0"
  limiter: false          # bot/rate limiter needs Valkey; this instance is internal-only
  public_instance: false
  image_proxy: false
search:
  safe_search: 0
  autocomplete: ""
  formats:
    - html
    - json
